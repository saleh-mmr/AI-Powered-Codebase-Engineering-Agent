+    assert auth_client.get(path + "?after=-1", headers=HEADERS).status_code == 422
+    assert auth_client.get(path, headers={**HEADERS, "Last-Event-ID": "NaN"}).status_code == 422
+    response = auth_client.get(path, headers=HEADERS)
