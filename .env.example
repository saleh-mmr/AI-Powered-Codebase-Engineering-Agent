# Local development only. Change this password; use URL-safe letters and digits.
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=repopilot
# Used inside Docker Compose. Must match the PostgreSQL values above.
APP_DATABASE_URL=postgresql+asyncpg://repopilot:change_this_local_password@postgres:5432/repopilot
APP_DATABASE_TIMEOUT_SECONDS=3
# Host frontend development only; Compose serves the built app through nginx.
API_PROXY_TARGET=http://127.0.0.1:8000
