+def sign_in(client: TestClient, email: str = "owner@example.com") -> dict[str, str]:
+    client.cookies.clear()
+    response = client.post(
+        "/auth/register",
+        json={"name": "Owner", "email": email, "password": "correct horse battery staple"},
+        headers=AUTH,
