+    return Response(status_code=204)
+
+
+@router.get("/files/{file_id}", response_model=IndexedFilePage)
+async def file(
+    repository_id: UUID,
+    file_id: UUID,
+    identity: Reader,
+    service: Service,
+    symbol_offset: Annotated[int, Query(ge=0, le=10000)] = 0,
+    chunk_offset: Annotated[int, Query(ge=0, le=10000)] = 0,
+) -> IndexedFilePage:
